# Copy to .env.local and fill in. .env.local is never committed (.gitignore).
# A secret must NEVER get a NEXT_PUBLIC_ prefix: that ships it to the browser.

# ---------------------------------------------------------------------------
# Domain (read today, in proxy.ts)
# ---------------------------------------------------------------------------
# The host salons live under. "frizerstvo-test.domena.si" -> slug
# "frizerstvo-test". Leave it EMPTY in development: then *.localhost works and
# platform hosts (*.vercel.app) correctly count as having no subdomain.
# Set it in production, so only real salon subdomains are recognised.
ROOT_DOMAIN=

# ---------------------------------------------------------------------------
# Supabase (phase 2: replaces the mock inside lib/data.ts)
# ---------------------------------------------------------------------------
# Project URL and the anon key. Both are public by design; the anon key may only
# do what the RLS policies in specs/schema.sql allow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: BYPASSES row level security. Server code only — the public
# booking form and the cancel link need it, because visitors have no account.
# Never import it into a client component and never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# E-mail (phase 2: confirmations, reminders, cancellations)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Sender shown to customers, on a domain verified with the mail provider.
EMAIL_FROM="Termin <termin@domena.si>"

# ---------------------------------------------------------------------------
# Reminders
# ---------------------------------------------------------------------------
# Shared secret the reminder cron sends as a header, so only the scheduler can
# trigger the run. Generate with: openssl rand -base64 32
CRON_SECRET=
