# Copy this file to .env.local and fill in the values:  cp .env.example .env.local
# .env.local is ignored by git. NEVER commit real values, and never put a secret
# in a variable that starts with NEXT_PUBLIC_ (those end up in the browser).
#
# Marked [in use] = read by the code today. All others are for later weeks.

# ---------------------------------------------------------------- Hosting
# [in use] Root domain of the platform, without protocol, e.g. "domena.si".
# proxy.ts takes the salon's slug from the subdomain in front of it
# (salon.domena.si -> "salon"). Leave empty on localhost. On Vercel preview
# URLs (x.vercel.app) it must be set, otherwise "x" is read as a salon slug.
# Links in e-mails (cancel, new password) use https://<slug>.<ROOT_DOMAIN>;
# without it they point to http://<slug>.localhost:3000, and production refuses.
ROOT_DOMAIN=

# ---------------------------------------------------------------- Supabase (week 6+)
# Supabase > Project Settings > API Keys. Region must be Frankfurt (eu-central-1).
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Public on purpose: it acts as the "anon"
# role, and grants + RLS (003_rls.sql) decide what it may see.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET key (sb_secret_...). Acts as "service_role" and bypasses RLS. Only
# lib/supabase/admin.ts may read it, server side only. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- E-mail: Resend
# [in use] SECRET. Resend > API Keys, permission "Sending access". Without it
# (or without EMAIL_FROM) no e-mail is sent and everything else still works.
RESEND_API_KEY=
# [in use] Sender address. Only the address is used: the display name is the
# salon's name, and Reply-To is the salon's own e-mail (salons.email).
# Development without a domain: "Termin <onboarding@resend.dev>" (Resend then
# delivers only to the e-mail of your own Resend account).
# Production: an address on a domain verified in Resend, e.g. "Termin <obvestila@mail.domena.si>".
EMAIL_FROM=

# ---------------------------------------------------------------- Hourly job (week 11)
# [in use] SECRET. app/api/cron/reminders runs only with the header
#   Authorization: Bearer <CRON_SECRET>
# Without it the job refuses to run (reminders, three-year retention, cleanup).
# Generate one with:  openssl rand -base64 32
# Who calls it every hour (decision 1b): cron-job.org, GET
# https://<ROOT_DOMAIN>/api/cron/reminders with that header. Vercel Cron (Pro
# plan, vercel.json) sends the same header and works without code changes.
CRON_SECRET=

# ---------------------------------------------------------------- Cloudflare Turnstile (week 11)
# Public site key, rendered in the booking form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRET. Used only to verify the token on the server.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- Rate limiting (week 11, optional)
# Default is the rate_limits table in Postgres. Only fill these in if you use Upstash instead.
UPSTASH_REDIS_REST_URL=
# SECRET.
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- Sentry (error reporting)
# A DSN is not a secret (it only allows sending events), so the public copy is fine.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# SECRET. Only for uploading source maps during the build.
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------- Platform owner (/super, week 10)
# [in use] The only e-mail allowed into /super (lib/super-admin.ts). Checked on
# the server, never in the browser. Empty = nobody gets in. Sign in at
# http://localhost:3000/prijava?next=/super (main domain, not a salon's subdomain).
SUPER_ADMIN_EMAIL=
# Optional. Resend plan limits for the warning at 80 % on /super. Default: the
# free plan, 3000 a month and 100 a day.
RESEND_MONTHLY_QUOTA=
RESEND_DAILY_QUOTA=
